{
  "name": "coralline-mcp",
  "version": "0.1.4",
  "description": "MCP server for Coralline — AI-agent-friendly SuperCollider synthesis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "coralline-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-osc": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-osc": "^9.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
